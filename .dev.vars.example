# Cloudflare Turnstile's documented always-pass test keys. Use only locally.
ENVIRONMENT=development
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
TURNSTILE_TEST_MODE=true
POLL_MIN_SAMPLE=1

# Replace this value with a long, random local-only string.
ANON_HASH_SALT=replace-with-a-long-random-string

# Local-only admin access. The deployed site uses Cloudflare Access JWTs.
ADMIN_EMAILS=admin@example.com
ADMIN_TEST_MODE=true
ADMIN_TEST_EMAIL=admin@example.com

# Set these on Cloudflare after creating the Access application.
ACCESS_TEAM_DOMAIN=https://your-team.cloudflareaccess.com
ACCESS_AUD=replace-with-access-application-audience-tag

